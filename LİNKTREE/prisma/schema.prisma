generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  EDITOR
  ANALYST
}

enum ClaimStatus {
  VERIFIED_PUBLIC
  QUALIFIED_PUBLIC
  DRAFT
  EXPIRED
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  name         String
  passwordHash String
  role         Role       @default(EDITOR)
  isActive     Boolean    @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  auditLogs    AuditLog[]
  revisions    PublishedRevision[]
}

model SiteSetting {
  id                     String   @id @default("site")
  defaultLocale          String   @default("tr")
  supportedLocales       String   @default("tr,en")
  siteUrl                 String   @default("http://localhost:3000")
  brandName               String   @default("HeimerClean")
  themeJson               Json
  analyticsRetentionDays Int      @default(90)
  updatedAt               DateTime @updatedAt
}

model ContentEntry {
  id        String   @id @default(cuid())
  key       String
  locale    String
  valueJson Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([key, locale])
}

model PageSection {
  id        String   @id @default(cuid())
  type      String   @unique
  sortOrder Int
  enabled   Boolean  @default(true)
  configJson Json
  updatedAt DateTime @updatedAt
}

model Link {
  id              String          @id @default(cuid())
  slug            String          @unique
  platform        String
  category        String
  destinationUrl  String
  titleTr         String
  titleEn         String
  descriptionTr   String
  descriptionEn   String
  ctaTr           String          @default("Aç")
  ctaEn           String          @default("Open")
  iconKey         String
  accentColor     String
  sortOrder       Int
  featured        Boolean         @default(false)
  active          Boolean         @default(true)
  utmJson         Json
  publishFrom     DateTime?
  publishUntil    DateTime?
  lastCheckedAt   DateTime?
  lastStatusCode  Int?
  lastCheckState  String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  clickEvents     ClickEvent[]
  aliases         RedirectAlias[]
  @@index([active, sortOrder])
}

model RedirectAlias {
  id        String   @id @default(cuid())
  oldSlug   String   @unique
  linkId    String
  link      Link     @relation(fields: [linkId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model Claim {
  id               String      @id @default(cuid())
  valueShort       String
  titleTr          String
  titleEn          String
  descriptionTr    String
  descriptionEn    String
  methodologyTr    String
  methodologyEn    String
  disclaimerTr     String
  disclaimerEn     String
  sourceType       String
  sourceUrl        String?
  sampleSize       String?
  testEnvironment  String?
  lastVerifiedAt   DateTime?
  expiresAt        DateTime?
  status           ClaimStatus @default(DRAFT)
  sortOrder        Int
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  @@index([status, sortOrder])
}

model Faq {
  id         String   @id @default(cuid())
  questionTr String
  questionEn String
  answerTr   String
  answerEn   String
  sortOrder  Int
  enabled    Boolean  @default(true)
  updatedAt  DateTime @updatedAt
}

model MediaAsset {
  id          String   @id @default(cuid())
  storageKey  String   @unique
  usageKey    String?  @unique
  mimeType    String
  sizeBytes   Int
  altTr       String
  altEn       String
  decorative  Boolean  @default(false)
  checksum    String
  createdAt   DateTime @default(now())
}

model PublishedRevision {
  id             String   @id @default(cuid())
  versionNumber  Int      @unique
  snapshotJson   Json
  publishedById  String?
  publishedBy    User?    @relation(fields: [publishedById], references: [id])
  restoredFromId String?
  publishedAt    DateTime @default(now())
}

model ClickEvent {
  id            String   @id @default(cuid())
  eventName     String
  linkId        String?
  link          Link?    @relation(fields: [linkId], references: [id], onDelete: SetNull)
  sessionHash   String?
  locale        String?
  persona       String?
  placement     String?
  referrerGroup String?
  utmJson       Json
  deviceClass   String?
  createdAt     DateTime @default(now())
  @@index([createdAt])
  @@index([linkId, createdAt])
}

model AuditLog {
  id          String   @id @default(cuid())
  actorUserId String?
  actor       User?    @relation(fields: [actorUserId], references: [id])
  action      String
  entityType  String
  entityId    String
  beforeJson  Json?
  afterJson   Json?
  createdAt   DateTime @default(now())
  @@index([entityType, entityId, createdAt])
}
